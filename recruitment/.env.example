# מקומי בלבד — ב-Railway המשתנה הזה מגיע אוטומטית מה-Postgres plugin
DATABASE_URL=postgresql://user:password@localhost:5432/recruitment_app
PORT=3000

# פרטי השגריר-מנהל שנוצר אוטומטית בהרצה הראשונה (כשאין עדיין אף שגריר במערכת).
# רק למנהל יש קוד גישה — שגרירים רגילים נכנסים בלי קוד ממסך "מי אתה?".
# אפשר לשנות קוד בכל עת דרך מסך "ניהול" לאחר הכניסה.
ADMIN_NAME=מנהל
ADMIN_PIN=1414

# הכתובת הציבורית המלאה של השירות — משמשת לבניית קישורי הזמנה אישיים בדוח (אקסל/גוגל שיטס)
# PUBLIC_BASE_URL=https://your-domain.example.com
