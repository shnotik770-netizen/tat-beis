# מקומי בלבד — ב-Railway המשתנה הזה מגיע אוטומטית מה-Postgres plugin
DATABASE_URL=postgresql://user:password@localhost:5432/recruitment_app
PORT=3000

# פרטי המנהל שנוצרים אוטומטית בהרצה הראשונה (כשאין עדיין אף שגריר במערכת)
# חשוב: הגדירו כאן קוד אישי לפני הפריסה הראשונה, או היכנסו מיד אחרי העלייה ושנו קוד דרך "הפרופיל שלי"
ADMIN_NAME=מנהל
ADMIN_PIN=1234
